# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://pms:pms@localhost:5432/pms?schema=public"

# ---------------------------------------------------------------------------
# Auth — change this in every environment. Must be at least 32 characters.
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
PLATFORM_NAME="RentRewards"
DEFAULT_COMMISSION_RATE=1.0          # percent, platform default (spec §16)
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi

# ---------------------------------------------------------------------------
# Payment provider (M-Pesa). Phase 1 ships a MOCK provider.
# Set PAYMENTS_PROVIDER=mpesa only once real, authorised Safaricom Daraja
# credentials are configured for the deployment.
# ---------------------------------------------------------------------------
PAYMENTS_PROVIDER=mpesa-mock
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:3000/api/v1/webhooks/mpesa?token=change-me"
# Required in production. Must match the ?token= on MPESA_CALLBACK_URL.
MPESA_WEBHOOK_SECRET="change-me"

# ---------------------------------------------------------------------------
# Tax provider (KRA eRITS). Phase 1 ships a MOCK provider that never contacts
# KRA. Production integration must use officially authorised KRA channels only.
# ---------------------------------------------------------------------------
TAX_PROVIDER=erits-mock
ERITS_ENVIRONMENT=mock
ERITS_BASE_URL=""
ERITS_CLIENT_ID=""
ERITS_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
NOTIFICATIONS_PROVIDER=console
SMS_SENDER_ID="PMS"
EMAIL_FROM="no-reply@example.co.ke"
